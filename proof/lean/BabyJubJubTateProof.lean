theorem concrete_check_rejects_all_nonidentity_torsion :
    ∀ p ∈ nonidentityTorsionPoints,
      OnCurve p ∧ modExp (tateMillerValue p) TateFinalExponent Q ≠ 1 := by
  intro p hp
  simp [nonidentityTorsionPoints] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    unfold OnCurve <;> native_decide

def reducedTateCharacter (p : FullGroupPoint) : Nat :=
  smallRootPower (tateClass p).val

theorem reduced_tate_character_eq_one_iff_prime_subgroup (p : FullGroupPoint) :
    reducedTateCharacter p = 1 ↔ InPrimeOrderSubgroup p := by
  have hroot : ∀ e : μ8Exponent, smallRootPower e.val = 1 ↔ e = 0 := by
    native_decide
  rw [reducedTateCharacter, hroot, tateClass_eq_zero_iff_prime_subgroup]

theorem reduced_tate_character_eq_one_iff_canonical_order_check (p : FullGroupPoint) :
    reducedTateCharacter p = 1 ↔ canonicalOrderCheck p :=
  (reduced_tate_character_eq_one_iff_prime_subgroup p).trans
    (canonical_order_check_iff_prime_subgroup p).symm

/-- Predicate implemented by `isInCorrectSubgroupAssumingOnCurveTate`, with
the precompile result represented by `modExp`. -/
def solidityTateAccepts (p : Affine) : Prop :=
  p = identity ∨ modExp (tateMillerValue p) TateFinalExponent Q = 1

/-- The facts supplied by the standard cyclic-group and reduced-Tate pairing
model when `p` represents the discrete-log class `index`.

`identity_index` covers the exceptional Edwards identity handled before the
birational map. A zero concrete Miller value occurs at a zero or pole in the
chosen representative and is a nonidentity torsion point, hence cannot be in
the prime-order subgroup. At every regular point, `pairing_character` is
bilinearity/non-degeneracy specialized to the fixed order-eight point. -/
structure TateEncodingLaws (p : Affine) (index : FullGroupPoint) : Prop where
  on_curve : OnCurve p
  identity_index : p = identity → index = fullGroupZero
  zero_value_not_prime : p ≠ identity →
    modExp (tateMillerValue p) TateFinalExponent Q = 0 →
    ¬InPrimeOrderSubgroup index
  pairing_character : p ≠ identity →
    modExp (tateMillerValue p) TateFinalExponent Q ≠ 0 →
    modExp (tateMillerValue p) TateFinalExponent Q = reducedTateCharacter index

theorem solidity_tate_accepts_iff_prime_order_subgroup
    (p : Affine) (index : FullGroupPoint) (laws : TateEncodingLaws p index) :
    solidityTateAccepts p ↔ InPrimeOrderSubgroup index := by
  by_cases hid : p = identity
  · have hindex : index = fullGroupZero := laws.identity_index hid
    rw [hindex]
    constructor
    · intro _
      exact ⟨⟨0, r_pos⟩, rfl⟩
    · intro _
      exact Or.inl hid
  · rw [solidityTateAccepts, or_iff_right hid]
    by_cases hzero : modExp (tateMillerValue p) TateFinalExponent Q = 0
    · constructor
      · intro hone
        omega
      · intro hprime
        exact False.elim (laws.zero_value_not_prime hid hzero hprime)
    · rw [laws.pairing_character hid hzero]
      exact reduced_tate_character_eq_one_iff_prime_subgroup index

theorem solidity_tate_accepts_iff_canonical_order_check
    (p : Affine) (index : FullGroupPoint) (laws : TateEncodingLaws p index) :
    solidityTateAccepts p ↔ canonicalOrderCheck index :=
  (solidity_tate_accepts_iff_prime_order_subgroup p index laws).trans
    (canonical_order_check_iff_prime_subgroup index).symm

end BabyJubJub.TateProof
