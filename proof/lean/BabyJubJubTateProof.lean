theorem full_generator_on_curve : OnCurve fullGenerator := by
  unfold OnCurve fullGenerator addmod mulmod Q A D
  native_decide

theorem full_generator_miller_value :
    tateMillerValue fullGenerator = FullGeneratorMillerValue := by
  native_decide

/-- Binary modular exponentiation, matching the mathematical result returned by
the EVM ModExp precompile for positive moduli. -/
def modExp (base exponent modulus : Nat) : Nat :=
  if exponent = 0 then 1 % modulus
  else
    let half := modExp base (exponent / 2) modulus
    let square := (half * half) % modulus
    if exponent % 2 = 0 then square else (square * (base % modulus)) % modulus
termination_by exponent
decreasing_by omega

set_option maxRecDepth 10000 in
theorem modExp_eq_pow_mod (base exponent modulus : Nat) :
    modExp base exponent modulus = base ^ exponent % modulus := by
  induction exponent using Nat.strongRecOn with
  | ind exponent ih =>
      rw [modExp]
      split
      · rename_i hzero
        simp [hzero]
      · rename_i hnonzero
        have hhalf : exponent / 2 < exponent := by omega
        rw [ih (exponent / 2) hhalf]
        split
        · rename_i heven
          have hexponent : exponent = 2 * (exponent / 2) := by
            have hsplit := Nat.mod_add_div exponent 2
            omega
          have htwice : 2 * (exponent / 2) = exponent / 2 + exponent / 2 := by omega
          calc
            _ = (base ^ (exponent / 2) * base ^ (exponent / 2)) % modulus :=
              (Nat.mul_mod (base ^ (exponent / 2)) (base ^ (exponent / 2)) modulus).symm
            _ = base ^ (exponent / 2 + exponent / 2) % modulus := by rw [Nat.pow_add]
            _ = base ^ exponent % modulus := by rw [← htwice, ← hexponent]
        · rename_i hodd
          have hexponent : exponent = 2 * (exponent / 2) + 1 := by
            have hmodlt := Nat.mod_lt exponent (by omega : 0 < 2)
            have hsplit := Nat.mod_add_div exponent 2
            omega
          have htwice : 2 * (exponent / 2) = exponent / 2 + exponent / 2 := by omega
          calc
            _ = ((base ^ (exponent / 2) * base ^ (exponent / 2)) % modulus *
                (base % modulus)) % modulus := by
              apply congrArg (fun z => z * (base % modulus) % modulus)
              exact (Nat.mul_mod (base ^ (exponent / 2)) (base ^ (exponent / 2)) modulus).symm
            _ = ((base ^ (exponent / 2) * base ^ (exponent / 2)) * base) % modulus :=
              (Nat.mul_mod (base ^ (exponent / 2) * base ^ (exponent / 2)) base modulus).symm
            _ = base ^ (exponent / 2 + exponent / 2 + 1) % modulus := by
              rw [Nat.pow_add, Nat.pow_add, Nat.pow_one]
            _ = base ^ exponent % modulus := by rw [← htwice, ← hexponent]

def TateGeneratorValue : Nat :=
  19540430494807482326159819597004422086093766032135589407132600596362845576832

theorem full_generator_final_exponentiation :
    modExp FullGeneratorMillerValue TateFinalExponent Q = TateGeneratorValue := by
  native_decide

def smallRootPower (e : Nat) : Nat := TateGeneratorValue ^ e % Q

theorem tate_generator_has_exact_order_eight :
    smallRootPower 8 = 1 ∧ smallRootPower 1 ≠ 1 ∧
    smallRootPower 2 ≠ 1 ∧ smallRootPower 4 ≠ 1 := by
  native_decide

